---
import Layout from '../layouts/Layout.astro';
import { CONTACT_EMAIL, SITE_TITLE } from '../consts';

const lastUpdated = 'November 27, 2026';
---

<Layout title="Terms &amp; Conditions" description={`The terms that govern use of the ${SITE_TITLE} website.`}>
  <section class="mx-auto max-w-3xl px-6 py-20 lg:px-8">
    <h1 class="text-3xl font-bold text-slate-900">Terms &amp; Conditions</h1>
    <p class="mt-2 text-sm text-slate-500">Last updated: {lastUpdated}</p>

    <div class="mt-10 space-y-8 text-slate-700">
      <p>
        These Terms &amp; Conditions ("Terms") govern your use of this website, operated by{' '}
        {SITE_TITLE} ("we", "us", "our"). By using this website, you agree to these Terms.
      </p>

      <div>
        <h2 class="text-xl font-semibold text-slate-900">About this website</h2>
        <p class="mt-2">
          This website provides information about {SITE_TITLE}'s certificate programs in Business
          Analysis, Project Management, and Leadership &amp; Strategic Management, our founder, and
          our leadership and management consulting services, and a way to contact us. It does not
          process payments or enrollments directly.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-slate-900">Use of this website</h2>
        <p class="mt-2">
          You may browse this website and use the Contact Us form for legitimate enquiries about
          our programs and services. Content on this site is provided for general informational
          purposes and does not guarantee specific outcomes, employment results, or equivalency
          with any external accreditation or licensing body unless explicitly stated.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-slate-900">Certificate programs</h2>
        <p class="mt-2">
          Program fees, payment methods, and semester offerings described on this site are
          informational. Enrollment, payment, and the issuance of a certificate of completion are
          arranged directly with us and are not completed through this website.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-slate-900">Intellectual property</h2>
        <p class="mt-2">
          The text, graphics, logo, and course descriptions on this website belong to {SITE_TITLE}
          unless otherwise noted, and may not be reproduced or used without our prior written
          permission.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-slate-900">Third-party links and services</h2>
        <p class="mt-2">
          This site links to third-party services, including WhatsApp and LinkedIn, and uses a
          third-party service to process Contact Us form submissions. We are not responsible for
          the content, policies, or practices of any third-party service you choose to use.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-slate-900">No professional advice</h2>
        <p class="mt-2">
          Information on this website is provided for general informational and educational
          purposes and is not a substitute for individualized professional, legal, or financial
          advice specific to your circumstances.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-slate-900">Limitation of liability</h2>
        <p class="mt-2">
          This website and its content are provided "as is" without warranties of any kind. To
          the extent permitted by law, {SITE_TITLE} is not liable for any indirect, incidental, or
          consequential damages arising from your use of this website.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-slate-900">Changes to these terms</h2>
        <p class="mt-2">
          We may update these Terms from time to time. The "Last updated" date at the top of this
          page reflects the most recent revision, and continued use of the website after changes
          are posted means you accept the revised Terms.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-slate-900">Contact us</h2>
        <p class="mt-2">
          Questions about these Terms can be sent to{' '}
          <a href={`mailto:${CONTACT_EMAIL}`} class="font-semibold text-brand-600 hover:text-brand-700">
            {CONTACT_EMAIL}
          </a>{' '}
          or via the <a href="/contact/" class="font-semibold text-brand-600 hover:text-brand-700">Contact Us</a> page.
        </p>
      </div>
    </div>
  </section>
</Layout>
