---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import CourseCard from '../components/CourseCard.astro';
import Button from '../components/ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { CONSULTING_WHATSAPP_DISPLAY, CONSULTING_WHATSAPP_LINK } from '../consts';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);

const highlights = [
  { label: 'Years in consulting & leadership', value: '12+' },
  { label: 'Years in change management', value: '9+' },
  { label: 'Certificate programs', value: '3' },
  { label: 'Delivery', value: '100% Online' },
];

const individuals = [
  'Graduates and emerging professionals',
  'Mid-career professionals seeking advancement',
  'Aspiring business analysts and project managers',
  'Current and future leaders',
];

const organizations = [
  'Aspiring corporate institutions and public sector leaders',
  'Small and medium-sized business owners',
  'Non-profit organization leaders',
  'Educational and professional institutions leaders',
];

const whyAscend = [
  {
    icon: 'lucide:globe',
    title: 'Learning Without Borders',
    description: 'Empowering students to learn, grow, and advance their careers from anywhere in the world.',
  },
  {
    icon: 'lucide:calendar-clock',
    title: 'Learn at Your Own Pace',
    description: 'Choose one or more courses each semester to suit your schedule and learning goals.',
  },
  {
    icon: 'lucide:lightbulb',
    title: 'Innovation',
    description: 'Learning and solutions that respond to evolving business needs.',
  },
  {
    icon: 'lucide:award',
    title: 'Excellence',
    description: 'High standards in professional practice and delivery.',
  },
  {
    icon: 'lucide:refresh-cw',
    title: 'Transformation',
    description: 'Turning strategy and knowledge into meaningful change.',
  },
  {
    icon: 'lucide:briefcase',
    title: 'Pathway to Practical Experience',
    description:
      'Opportunity to qualify for a three-month apprenticeship placement, subject to eligibility and availability.',
  },
];
---

<Layout title="Professional Training in Business Analysis, Project Management & Leadership">
  <Hero
    eyebrow="Ascend Professional Institute"
    title="Build the capabilities organizations need for sustainable success"
    description="In a rapidly changing business environment, organizations need more than qualified employees — they need capable professionals, effective leaders, and strategic thinkers who can turn knowledge into results."
    primaryCta={{ label: 'Explore Programs', href: '/courses/' }}
    secondaryCta={{ label: 'Meet Your Trainer', href: '/about/' }}
  />

  <section class="border-b border-slate-100 bg-white">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-6 py-12 sm:grid-cols-4 lg:px-8">
      {
        highlights.map((item) => (
          <div class="text-center">
            <p class="text-3xl font-bold text-brand-900">{item.value}</p>
            <p class="mt-1 text-sm text-slate-700">{item.label}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
    <SectionHeading
      eyebrow="Who We Serve"
      title="Built for individuals and organizations alike"
      align="center"
    />

    <div class="mt-12 grid gap-8 sm:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-8">
        <h3 class="text-lg font-semibold text-slate-900">Individuals</h3>
        <ul class="mt-4 space-y-3">
          {individuals.map((item) => <li class="text-sm text-slate-700">{item}</li>)}
        </ul>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-8">
        <h3 class="text-lg font-semibold text-slate-900">Organizations</h3>
        <ul class="mt-4 space-y-3">
          {organizations.map((item) => <li class="text-sm text-slate-700">{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
      <SectionHeading eyebrow="Why Ascend?" title="What makes our programs different" align="center" />

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          whyAscend.map((item) => (
            <div class="rounded-2xl bg-white p-6 shadow-sm">
              <div class="flex items-center justify-between gap-3">
                <h3 class="font-semibold text-slate-900">{item.title}</h3>
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-700">
                  <Icon name={item.icon} class="h-5 w-5" />
                </div>
              </div>
              <p class="mt-3 text-sm text-slate-700">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
    <SectionHeading
      eyebrow="Certificate Programs"
      title="Three courses. One certificate. Delivered online."
      description="Each program is delivered as three 12-week courses. Complete all three to earn your Certificate of Completion."
      align="center"
    />

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {courses.map((course) => <CourseCard course={course} />)}
    </div>
  </section>

  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
      <SectionHeading
        eyebrow="Consulting Programs"
        title="Leadership and management consulting, institutional transformation, and mentorship"
        description="Serving private institutions and organizations, government and public-sector organizations, and individual professionals and leaders seeking structured mentorship and development."
      />

      <div class="mt-12 grid gap-8 sm:grid-cols-2">
        <div class="rounded-2xl border border-slate-200 bg-white p-8">
          <h3 class="text-lg font-semibold text-slate-900">Leadership Development</h3>
          <ul class="mt-4 space-y-2 text-sm text-slate-700">
            <li>Strategic leadership</li>
            <li>Emotional intelligence</li>
            <li>Team effectiveness</li>
            <li>Executive development</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-8">
          <h3 class="text-lg font-semibold text-slate-900">Management Consulting</h3>
          <ul class="mt-4 space-y-2 text-sm text-slate-700">
            <li>Transformation</li>
            <li>Process improvement</li>
            <li>Change management</li>
            <li>Organizational effectiveness</li>
          </ul>
        </div>
      </div>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 rounded-2xl border-slate-200 p-6 text-center sm:flex-row">
        <Icon name="simple-icons:whatsapp" class="h-6 w-6 shrink-0 text-[#25D366]" />
        <p class="text-sm text-slate-700">
          Contact for a free 15-minute consultation &mdash; WhatsApp us at{' '}
          <a href={CONSULTING_WHATSAPP_LINK} class="font-semibold text-brand-600 hover:text-brand-700">
            {CONSULTING_WHATSAPP_DISPLAY}
          </a>
        </p>
      </div>
    </div>
  </section>

  <section class="bg-brand-900">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-6 py-16 text-center lg:px-8">
      <h2 class="text-3xl font-bold text-white">Ready to bring this training to your team?</h2>
      <p class="max-w-xl text-brand-100">
        Available for certificate programs, corporate training, and consulting engagements.
      </p>
      <Button href="/contact/" variant="secondary">Get in Touch</Button>
    </div>
  </section>
</Layout>
