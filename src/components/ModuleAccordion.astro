---
interface CourseModule {
  code: string;
  title: string;
  duration: string;
  description: string;
  outcomes: string[];
}

interface Props {
  modules: CourseModule[];
}

const { modules } = Astro.props;
---

<div class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
  {
    modules.map((courseItem, index) => (
      <details class="group p-6 open:bg-slate-50" open={index === 0}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4">
          <div class="flex items-start gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
              {index + 1}
            </span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-brand-600">
                {courseItem.code} &middot; {courseItem.duration}
              </p>
              <h3 class="mt-1 text-lg font-semibold text-slate-900">{courseItem.title}</h3>
            </div>
          </div>
          <svg
            class="mt-2 h-5 w-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
          </svg>
        </summary>

        <div class="mt-4 pl-[3.25rem]">
          <p class="text-sm text-slate-600">{courseItem.description}</p>

          <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-slate-500">
            Learning outcomes
          </p>
          <ul class="mt-2 grid gap-2 sm:grid-cols-2">
            {courseItem.outcomes.map((outcome) => (
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-500" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    fill-rule="evenodd"
                    d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                    clip-rule="evenodd"
                  />
                </svg>
                {outcome}
              </li>
            ))}
          </ul>
        </div>
      </details>
    ))
  }
</div>
